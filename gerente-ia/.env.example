# ============================================================================
# CONEXÃO COM O FUNCIONÁRIO NFI X8 (FREQTRADE REST API)
# ============================================================================
FREQTRADE_API_URL=http://127.0.0.1:8081
FREQTRADE_USERNAME=chefe
FREQTRADE_PASSWORD=123

# Tempo de castigo (bloqueio de entradas via /locks) quando TILTADO (em minutos)
CASTIGO_DURATION_MINUTES=60

# ============================================================================
# INTEGRAÇÃO DE IA ECONÔMICA (LLM ON-DEMAND)
# Opções de LLM_PROVIDER: gemini | openai | anthropic
# ============================================================================
LLM_PROVIDER=gemini
LLM_API_KEY=coloque_sua_api_key_aqui
LLM_MODEL=gemini-2.5-flash

# ============================================================================
# DISPARO EXECUTIVO PARA TELEGRAM
# ============================================================================
TELEGRAM_BOT_TOKEN=coloque_seu_bot_token_aqui
TELEGRAM_CHAT_ID=coloque_seu_chat_id_aqui

# ============================================================================
# PORTA DO MICROSERVIÇO GERENTE-IA
# ============================================================================
PORT=8090

